# Copy to .env (gitignored). Never commit real values.

# --- Team board (agent coordination). Ask aleksei for these values; share them privately, never in git.
TEAM_BOARD_URL=https://<deployment>.convex.cloud
TEAM_TOKEN=
# Optional overrides for your agent id (<human>-<tool>[-<worktree>])
# TEAM_HUMAN=ayaan
# AGENT_ID=

# --- Challenge-specific: added by /lock-challenge

# Valio Aimo mock API: key is on the Junction platform challenge page
VALIO_API_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=

# Demo buyer agent (Claude API tool use): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Guardrail default: orders above this (EUR) escalate to human approval
APPROVAL_SPEND_LIMIT_EUR=500
# Gateway port (app/server); the console proxies /api here
PORT=8787
# Optional: Ed25519 private key (PKCS8 PEM, \n-escaped) that signs offer receipts. Unset = a fresh key per start.
GATEWAY_SIGNING_KEY=
