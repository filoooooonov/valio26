# Copy to .env (gitignored). Never commit real values.

# --- Team board (agent coordination). Ask aleksei for these values; share them privately, never in git.
TEAM_BOARD_URL=https://<deployment>.convex.cloud
TEAM_TOKEN=
# Optional overrides for your agent id (<human>-<tool>[-<worktree>])
# TEAM_HUMAN=ayaan
# AGENT_ID=

# --- Challenge-specific: added by /lock-challenge

# Valio Aimo mock API: key is on the Junction platform challenge page
VALIO_API_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=

# Demo buyer agent (Claude API tool use): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Guardrail default: orders above this (EUR) escalate to human approval
APPROVAL_SPEND_LIMIT_EUR=500
# Gateway port (app/server); the console proxies /api here
PORT=8787

# Trusted purchasing: JSON array of server-side principals. Generate distinct random tokens (>=24 characters).
# Shape: [{"token":"<random-secret>","actor":"agent:kaleva","customer":"123","role":"agent"},
#         {"token":"<different-secret>","actor":"Mikko L.","customer":"123","role":"approver"}]
# Roles: agent, buyer, approver, admin. Set this before exposing the gateway.
# Empty = legacy LOCAL DEMO ONLY (v1 still refuses unauthenticated calls).
COMMERCE_PRINCIPALS_JSON=
# Default binding is loopback; never expose local demo mode publicly.
COMMERCE_HOST=127.0.0.1
COMMERCE_BROWSER_ORIGIN=http://localhost:5173
# Relative to app/server when started with bun run dev. Persistent local SIMULATED orders only.
COMMERCE_LEDGER_PATH=data/commerce/ledger.json
# For scripts/commerce-client.mjs only; never put these in VITE_* variables.
COMMERCE_URL=http://localhost:8787
COMMERCE_TOKEN=
# Dev-only routes (POST /api/dev/reset, used by `bun run demo:reset`). Leave unset outside local demos.
DEV_TOOLS=
